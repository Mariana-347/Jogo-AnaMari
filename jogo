# Cada repetição cria uma nova partida
while game:
    resultado = None
    fundo_y = HEIGHT - ALTURA_FUNDO
    # Criando um grupo de matinhos
    all_sprites = pygame.sprite.Group()
    plataformas = pygame.sprite.Group()
    # grupo dos sóis
    sois = pygame.sprite.Group()
    # Criando o jogador
    player = Ship(pascal_img)
    all_sprites.add(player)

    # Criando os matinhos
    for i in range(10):
        y = HEIGHT - 140 - i * intervalo_plataformas(fundo_y)
        for coluna in range(2):
            plataforma = matinho(matinho_img_small, y)
            inicio = coluna * (WIDTH // 2)
            fim = (coluna + 1) * (WIDTH // 2)
            plataforma.rect.x = random.randint(inicio, fim - plataforma.rect.width)
            # O número da fileira define a frequência e o lado da móvel.
            plataforma.configurar(coluna, i)
            plataformas.add(plataforma)
            all_sprites.add(plataforma)

    # Mantém a sequência de lados ao criar novas fileiras.
    proxima_linha = 10

    # criando o primeiro sol
    sol = Sol(sol_img)
    sois.add(sol)
    all_sprites.add(sol)

    #pedido do pulo
    pedido_pulo = False
    pontos=0

    while game:
        # aumenta a taxa de atualização para 60 FPS
        clock.tick(60)
        for event in pygame.event.get():
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    game = False
                elif event.key == pygame.K_SPACE or event.key == pygame.K_UP:
                    pedido_pulo = True

        if not game:
            break

        # movimentação horizontal contínua
        # Isso permite mudar de direção sem precisar apertar várias vezes.
        teclas = pygame.key.get_pressed()
        if teclas[pygame.K_LEFT]:
            player.speedx = -5
        elif teclas[pygame.K_RIGHT]:
            player.speedx = 5
        else:
            player.speedx = 0

        # Os matinhos descem enquanto o personagem está no ar
        personagem_movendo = not player.no_chao

        # Área visível do personagem dentro da imagem
        area_player = player.image.get_bounding_rect()

        # Posição dos pés antes do movimento
        pes_antes = player.rect.y + area_player.bottom

        # Guarda o topo visível de cada plataforma
        topos_antes = {}

        for plataforma in plataformas:
            area = plataforma.image.get_bounding_rect()
            topos_antes[plataforma] = (plataforma.rect.y + area.centery)

        # Movimenta o personagem e as plataformas
        player.update()

        plataformas.update(personagem_movendo)

        # movimenta os sóis
        sois.update(personagem_movendo)

        # O fundo desce enquanto o personagem está no ar
        if personagem_movendo:
            fundo_y += velocidade_fundo
            # Para ao mostrar o topo da imagem
            if fundo_y > 0:
                fundo_y = 0

        # Retângulo da parte visível do personagem na tela
        corpo = area_player.move(player.rect.x, player.rect.y)
        plataforma_pouso = None
        primeiro_instante = float("inf")

        for plataforma in plataformas:
            if not plataforma.ativa:
                continue
            area = plataforma.image.get_bounding_rect()
            apoio = area.move(plataforma.rect.x, plataforma.rect.y)
            sobrepoe_x = (corpo.right > apoio.left and corpo.left < apoio.right)
            distancia_antes = (topos_antes[plataforma] - pes_antes)
            distancia_depois = (apoio.centery - corpo.bottom)

            # Verifica se os pés alcançaram a plataforma por cima
            if (sobrepoe_x and distancia_antes >= 0 and distancia_depois <= 0 and player.speedy >= 0):
                movimento = distancia_antes - distancia_depois
                if movimento > 0:
                    instante = distancia_antes / movimento
                    if instante < primeiro_instante:
                        primeiro_instante = instante
                        plataforma_pouso = plataforma

        if plataforma_pouso is not None:
            area = plataforma_pouso.image.get_bounding_rect()
            topo = plataforma_pouso.rect.y + area.centery
            # Coloca os pés visíveis exatamente sobre o matinho
            player.rect.y = topo - area_player.bottom
            player.speedy = 0
            player.no_chao = True
            player.rect.x += plataforma_pouso.delta_x
            if plataforma_pouso.tipo == "fragil" and plataforma_pouso.tempo_sumir is None:
                plataforma_pouso.tempo_sumir = 30  # some meio segundo após o pouso

        # Derrota quando o personagem toca o chão
        if player.rect.bottom >= HEIGHT:
            resultado = "game_over"
            tocar_som("game_over")
            game = False
            break

        # Posição da porta na tela, acompanhando o fundo
        porta_tela = porta.move(0, int(fundo_y))

        # Atualiza o corpo após a correção da posição no pouso
        corpo = area_player.move(player.rect.x, player.rect.y)

        # Vitória quando o personagem encosta na porta
        if corpo.colliderect(porta_tela):
            resultado = "vitoria"
            tocar_som("vitoria")
            game = False
            break

        if player.no_chao and pedido_pulo:
           #executa o pulo assim q o jogador tocar no mato
            player.speedy = -15
            tocar_som("pulo")
            player.no_chao = False 
            # reseta o pedido 
            pedido_pulo = False 

        # Reaproveita os matinhos que saíram por baixo
        # Agrupa as plataformas que estão na mesma altura
        linhas = {}

        for plataforma in plataformas:
            y = plataforma.rect.y
            linhas.setdefault(y, []).append(plataforma)

        # Reposiciona cada dupla que saiu por baixo
        for y, linha in linhas.items():
            if y > HEIGHT:
                novo_y = min(plataforma.rect.y for plataforma in plataformas) - intervalo_plataformas(fundo_y)
                for coluna, plataforma in enumerate(linha):
                    inicio = coluna * (WIDTH // 2)
                    fim = (coluna + 1) * (WIDTH // 2)
                    plataforma.rect.x = random.randint(inicio, fim - plataforma.rect.width)
                    plataforma.rect.y = novo_y
                    plataforma.top_anterior = novo_y
                    plataforma.configurar(coluna, proxima_linha)
                proxima_linha += 1

        # verifica se o jogador coletou o sol
        if pygame.sprite.spritecollide(player, sois, False):
            pontos += 10
            tocar_som("sol")
            # O sol aparece em outro lugar depois de coletado
            sol.novo_sol()
        # Desenha o fundo
        window.blit(background, (0, int(fundo_y)))
        # Desenha os matinhos primeiro
        plataformas.draw(window)

        # desenha os sóis
        sois.draw(window)

        # Desenha o personagem por último
        player.desenhar(window)

        # mostra a pontuação na tela
        texto_pontos = font_pontos.render(f'Pontos: {pontos}',True,(128, 0, 128))
        window.blit(texto_pontos, (15, 15))
        texto_recorde = font_mensagem.render(f"Recorde: {max(recorde, pontos)}", True, (255, 255, 255))
        window.blit(texto_recorde, (15, 55))
        pygame.display.update()

    if resultado is not None and pontos > recorde:
        recorde = pontos
        erro_recorde = not salvar_recorde(recorde)

    # Tela final: aparece apenas em caso de vitória ou queda
    tela_final = resultado is not None

    while tela_final:
        clock.tick(60)
        for event in pygame.event.get():
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    tela_final = False
                    game = False
                elif event.key == pygame.K_RETURN:
                    tela_final = False
                    game = True

        if not tela_final:
            break

        # Desenha o cenário atrás da mensagem
        window.blit(background, (0, int(fundo_y)))

        # Escurece o fundo para facilitar a leitura
        sombra = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        sombra.fill((0, 0, 0, 170))
        window.blit(sombra, (0, 0))

        if resultado == "vitoria":
            titulo = "VITÓRIA!"
            mensagem = "Pascal chegou à torre!"
            cor = (255, 220, 100)
        else:
            titulo = "GAME OVER"
            mensagem = "Pascal caiu no chão!"
            cor = (255, 130, 130)

        texto_titulo = font_final.render(titulo, True, cor)
        texto_mensagem = font_mensagem.render(mensagem, True, (255, 255, 255))
        texto_final = font_pontos.render(f"Pontuação final: {pontos}", True, (255, 255, 255))
        texto_reiniciar = font_mensagem.render("ENTER para jogar novamente", True, (255, 255, 255))
        texto_sair = font_mensagem.render("Pressione ESC para sair", True, (255, 255, 255))

        window.blit(texto_titulo, texto_titulo.get_rect(center=(WIDTH // 2, 250)))
        window.blit(texto_mensagem, texto_mensagem.get_rect(center=(WIDTH // 2, 325)))
        window.blit(texto_final,texto_final.get_rect(center=(WIDTH // 2, 400)))
        aviso_recorde = " (não salvo)" if erro_recorde else ""
        texto_recorde = font_mensagem.render(f"Recorde: {recorde}{aviso_recorde}", True, (255, 220, 100))
        window.blit(texto_recorde, texto_recorde.get_rect(center=(WIDTH // 2, 440)))
        window.blit(texto_reiniciar, texto_reiniciar.get_rect(center=(WIDTH // 2, 490)))
        window.blit(texto_sair,texto_sair.get_rect(center=(WIDTH // 2, 520)))

        pygame.display.update()

pygame.quit()
