import pygame
import random
pygame.init ()

# define o tamanho da tela do jogo
WIDTH = 500
HEIGHT = 750
window = pygame.display.set_mode((WIDTH, HEIGHT))

# nome do jogo
pygame.display.set_caption('Jogo da MariAna')

# define  a cor e a fonte  do nome do jogo
font = pygame.font.SysFont("Cambria", 60)
text = font.render('SKY', True, (128, 0, 128))
text_ = font.render('HOPPER', True, (128, 0, 128))

MATINHO_WIDTH = 120
MATINHO_HEIGHT = 120
PASCAL_WIDTH = 100
PASCAL_HEIGHT = 100
background=pygame.image.load('fundo.png').convert()
matinho_img = pygame.image.load('matinho p jogo.png').convert_alpha()
matinho_img_small = pygame.transform.scale(matinho_img, (MATINHO_WIDTH, MATINHO_HEIGHT))
ship_img = pygame.image.load('pascal.png').convert_alpha()
ship_img = pygame.transform.scale(ship_img, (PASCAL_WIDTH, PASCAL_HEIGHT))

class Ship(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH / 2
        self.rect.bottom = HEIGHT - 10
        self.speedx = 0
        self.speedy = 0

    def update(self):
        self.rect.x += self.speedx
        self.rect.y += self.speedy
        # Mantem dentro da tela
        if self.rect.right > WIDTH:
            self.rect.right = WIDTH
        if self.rect.left < 0:
            self.rect.left = 0
        if self.rect.top < 0:
            self.rect.top = 0
        if self.rect.bottom > HEIGHT:
            self.rect.bottom = HEIGHT

# cria novas plataformas (matinhos)
class matinho(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, WIDTH - self.rect.width)
        self.rect.y = 0
        self.speedy = 5

    def update(self):
        # Atualizando a posição do matinho
        self.rect.y += self.speedy
        if self.rect.y > 750:
            self.rect.x = random.randint(0, WIDTH - self.rect.width)
            self.rect.y = 0

clock = pygame.time.Clock()

game = True

# Criando um grupo de matinhos
all_sprites = pygame.sprite.Group()
# Criando o jogador
player = Ship(ship_img)
all_sprites.add(player)
# Criando os matinhos
for i in range(3):
    matinhos = matinho(matinho_img_small)
    all_sprites.add(matinhos)

while game:
    clock.tick(15)
    for event in pygame.event.get():
        #se apertar o espaço o jogo fecha
        if event.type == pygame.QUIT:
            game = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                game = False
        # Verifica se apertou alguma tecla.
        if event.type == pygame.KEYDOWN:
            # Dependendo da tecla, altera a velocidade.
            if event.key == pygame.K_LEFT:
                player.speedx -= 100
                player.speedy -= 100
            if event.key == pygame.K_RIGHT:
                player.speedx += 100
                player.speedy -= 100
        # Verifica se soltou alguma tecla.
        if event.type == pygame.KEYUP:
            # Dependendo da tecla, altera a velocidade.
            if event.key == pygame.K_LEFT:
                player.speedx += 100
                player.speedy += 100
            if event.key == pygame.K_RIGHT:
                player.speedx -= 100
                player.speedy += 100

    # atualiza as posicoes dos matinhos
    all_sprites.update()
    
    # cor do fundo do jogo 
    window.fill((200, 162, 200))
    window.fill((200, 162, 200))
    # imagem de fundo 
    image = pygame.transform.scale(background,(500, 750))
    window.blit(image,(0, 0))

    # desenhando os matinhos
    all_sprites.draw(window)
 
    # posiciona o texto na tela do jogo
    # window.blit(text, (200, 300))
    # window.blit(text_, (150, 350))
    # window.blit(background, (0, 0))
    # window.blit(matinho_img_small, (matinho_x, matinho_y))

    pygame.display.update()
pygame.quit()
