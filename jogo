# Define o personagem como um sprite, com imagem, posição, velocidades e animação.
class Ship(pygame.sprite.Sprite):
    # Inicializa Pascal no centro horizontal, próximo à parte inferior da janela.
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        # Guarda a imagem e cria o retângulo que será usado para posicionar o personagem.
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH / 2
        self.rect.bottom = HEIGHT - 10
        # Define as velocidades e os estados iniciais de apoio, direção e animação.
        self.speedx = 0
        self.speedy = -15
        self.no_chao = True
        self.olhando_esquerda = False
        self.quadro_animacao = 0

    # Desenha a imagem de Pascal com orientação e tamanho que dependem do movimento.
    def desenhar(self, tela):
        # Espelha a imagem quando Pascal está olhando para a esquerda.
        imagem = pygame.transform.flip(self.image, self.olhando_esquerda, False)
        # Estica levemente a imagem na vertical enquanto Pascal estiver no ar.
        if not self.no_chao:
            tamanho = (PASCAL_WIDTH - 6, PASCAL_HEIGHT + 6)
        # Alterna pequenas deformações da imagem para simular movimento ao andar.
        elif self.speedx:
            oscilacao = 3 if (self.quadro_animacao // 6) % 2 else -3
            tamanho = (PASCAL_WIDTH + oscilacao, PASCAL_HEIGHT - oscilacao)
        # Mantém o tamanho normal quando Pascal está parado e apoiado.
        else:
            tamanho = (PASCAL_WIDTH, PASCAL_HEIGHT)
        # Desenha a imagem animada mantendo seus pés alinhados com o retângulo do personagem.
        imagem = pygame.transform.smoothscale(imagem, tamanho)
        retangulo = imagem.get_rect(midbottom=self.rect.midbottom)
        if tela is not None:
            tela.blit(imagem, retangulo)
        return imagem, retangulo

    # Atualiza a animação, as velocidades e os limites do personagem a cada quadro.
    def update(self):
        # Avança o contador usado para alternar os quadros da animação de caminhada.
        self.quadro_animacao += 1
        # Atualiza a direção para a qual Pascal olha quando existe movimento horizontal.
        if self.speedx:
            self.olhando_esquerda = self.speedx < 0
        self.rect.x += self.speedx
        # pulo suave
        self.speedy += 0.55
        #  movimento vertical contínuo
        self.rect.y += self.speedy
        # proteção para o personagem nao sair pelo teto
        if self.rect.top < 0:
            self.rect.top = 0
            self.speedy = 0
        # Limites laterais
        if self.rect.right > WIDTH:
            self.rect.right = WIDTH
        # Impede que o personagem ultrapasse a lateral esquerda da janela.
        if self.rect.left < 0:
            self.rect.left = 0
        # A colisão verificará se continua apoiado
        self.no_chao = False

# cria novas plataformas (matinhos)
class matinho(pygame.sprite.Sprite):
    # Cria uma plataforma com altura recebida e dados para controlar seus possíveis comportamentos.
    def __init__(self, img, y):
        pygame.sprite.Sprite.__init__(self)
        # Define a imagem, o retângulo e a posição inicial da plataforma.
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, WIDTH - self.rect.width)
        self.rect.y = y
        # Guarda a imagem original e inicia a plataforma como normal, ativa e sem contagem para sumir.
        self.imagem_original = img
        self.tipo = "normal"
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = 1
        self.delta_x = 0
        self.limite_esquerdo = 0
        self.limite_direito = WIDTH - self.rect.width

    # Configura a plataforma conforme sua coluna e o número da fileira.
    def configurar(self, coluna, numero_linha):
        # Uma plataforma móvel a cada quatro fileiras.
        # Os lados se alternam: esquerda, direita, esquerda, direita...
        linha_movel = numero_linha % 4 == 3
        lado_movel = (numero_linha // 4) % 2
        # Nas fileiras móveis, escolhe qual das duas colunas terá uma plataforma em movimento.
        if linha_movel:
            self.tipo = "movel" if coluna == lado_movel else "normal"
        # Nas outras fileiras após a primeira, sorteia uma plataforma normal ou frágil na coluna direita.
        elif numero_linha > 0 and coluna == 1:
            self.tipo = random.choice(["normal", "fragil"])
        # Mantém as demais plataformas como normais.
        else:
            self.tipo = "normal"
        # Reativa a plataforma e reinicia os dados de movimento e desaparecimento.
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = random.choice([-1, 1])
        self.delta_x = 0
        # Limita o deslocamento horizontal à metade da tela correspondente à coluna.
        self.limite_esquerdo = coluna * (WIDTH // 2)
        self.limite_direito = (coluna + 1) * (WIDTH // 2) - self.rect.width
        self.image = self.imagem_original.copy()
        # Aplica uma tonalidade azul às plataformas móveis.
        if self.tipo == "movel":
            self.image.fill((150, 200, 255, 255), special_flags=pygame.BLEND_RGBA_MULT)
        # Aplica uma tonalidade alaranjada às plataformas frágeis.
        elif self.tipo == "fragil":
            self.image.fill((255, 180, 140, 255), special_flags=pygame.BLEND_RGBA_MULT)

    # Atualiza o deslocamento, o desaparecimento e a descida de cada plataforma.
    def update(self, personagem_movendo):
        # Guarda a posição anterior para calcular quanto a plataforma se moveu neste quadro.
        x_anterior = self.rect.x
        # Desloca horizontalmente as plataformas móveis que ainda estão ativas.
        if self.tipo == "movel" and self.ativa:
            self.rect.x += self.direcao * 2
            # Ao atingir um limite da coluna, corrige a posição e inverte a direção.
            if self.rect.x <= self.limite_esquerdo or self.rect.x >= self.limite_direito:
                self.rect.x = max(self.limite_esquerdo, min(self.limite_direito, self.rect.x))
                self.direcao *= -1
        # Calcula o deslocamento horizontal que também poderá transportar Pascal durante o pouso.
        self.delta_x = self.rect.x - x_anterior
        # Se a plataforma frágil já foi tocada, diminui o tempo restante para desaparecer.
        if self.tempo_sumir is not None:
            self.tempo_sumir -= 1
            # Quando o tempo acaba, desativa a plataforma e substitui sua imagem por uma superfície transparente.
            if self.tempo_sumir <= 0:
                self.ativa = False
                self.image = pygame.Surface(self.imagem_original.get_size(), pygame.SRCALPHA)
        # Só desce enquanto o personagem está no ar
        if personagem_movendo:
            self.rect.y += 3

