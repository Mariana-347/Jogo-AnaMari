import pygame
import random
pygame.init ()
# define o tamanho da tela do jogo
WIDTH = 500
HEIGHT = 750
window = pygame.display.set_mode((WIDTH, HEIGHT))
# nome do jogo
pygame.display.set_caption('Jogo da MariAna')

# define  a cor e a fonte  do nome do jogo
font = pygame.font.SysFont("Cambria", 60)
text = font.render('SKY', True, (128, 0, 128))
text_ = font.render('HOPPER', True, (128, 0, 128))

MATINHO_WIDTH = 50
MATINHO_HEIGHT = 38
background=pygame.image.load('fundo.png').convert()
matinho_img = pygame.image.load('matinho p jogo.png').convert_alpha()
matinho_img_small = pygame.transform.scale(matinho_img, (MATINHO_WIDTH, MATINHO_HEIGHT))

game = True

# posiciona matinho
matinho_x = random.randint(0, WIDTH-MATINHO_WIDTH)
matinho_y = random.randint(0, HEIGHT-MATINHO_HEIGHT)
matinho_speedy = -5

while game:
    for event in pygame.event.get():
        #se apertar o espaço o jogo fecha
        if event.type == pygame.KEYUP:
            pygame.quit()
            game = False

    matinho_y += matinho_speedy

    if matinho_y > HEIGHT or matinho_x + MATINHO_WIDTH < 0 or matinho_x > WIDTH:
        matinho_x = random.randint(0, WIDTH-MATINHO_WIDTH)
        matinho_y = -MATINHO_HEIGHT
    
    # cor do fundo do jogo 
    window.fill((200,162,200))
    window.fill((200,162,200))
# imagem de fundo 
    image = pygame.transform.scale(background,(500,750))
    window.blit(image,(0,0))

# posiciona o texto na tela do jogo
    window.blit(text, (200, 300))
    window.blit(text_, (150, 350))

    window.blit(background, (0, 0))
    window.blit(matinho_img_small, (matinho_x, matinho_y))

    pygame.display.update()
pygame.quit()
