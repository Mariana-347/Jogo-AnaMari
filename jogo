# PARTIDA

def jogar_fase(fase_atual, pontos_iniciais):
    """Executa uma fase e devolve seu resultado, os pontos e a posição do fundo."""
    # Estes recursos também são usados pelas funções existentes de desenho e animação.
    global background, ALTURA_FUNDO, luz_img
    game = True
    # Recria cenário, personagem, plataformas e itens para a fase escolhida.
    background, ALTURA_FUNDO, objetivo, matinho_img_small, pascal_img, sol_img, luz_img = carregar_fase(fase_atual)
    resultado = None
    fundo_y = HEIGHT - ALTURA_FUNDO

    # Criando um grupo de matinhos
    plataformas = pygame.sprite.Group()
    # grupo dos sóis
    sois = pygame.sprite.Group()
    # Criando o jogador
    player = Ship(pascal_img)

    # Criando os matinhos
    # Percorre as dez fileiras que formarão as primeiras plataformas da fase.
    for i in range(10):
        y = HEIGHT - 140 - i * intervalo_plataformas(fundo_y)
        # Cria uma plataforma em cada uma das duas metades horizontais da tela.
        for coluna in range(2):
            plataforma = matinho(matinho_img_small, y)
            inicio = coluna * (WIDTH // 2)
            fim = (coluna + 1) * (WIDTH // 2)
            # Sorteia a posição horizontal dentro da coluna, deixando espaço para toda a plataforma.
            plataforma.rect.x = random.randint(inicio, fim - plataforma.rect.width)
            # O número da fileira define a frequência e o lado da móvel.
            plataforma.configurar(coluna, i)
            plataformas.add(plataforma)

    # Mantém a sequência de lados ao criar novas fileiras.
    # Guarda o número da próxima fileira para manter o padrão de plataformas móveis.
    proxima_linha = 10

    # criando o primeiro sol
    sol = Sol(sol_img)
    sois.add(sol)

    #pedido do pulo
    pedido_pulo = False
    pontos = pontos_iniciais  # Os pontos da fase 1 continuam na fase 2.
    # Cria um grupo com um único item especial e inicia seus efeitos como desativados.
    itens = pygame.sprite.GroupSingle(ItemEspecial())
    escudo = False
    tempo_superpulo = 0
    # Guarda a distância inicial até o objetivo para depois calcular o progresso da subida.
    distancia_inicial_objetivo = max(1, player.rect.centery - (objetivo.centery + fundo_y))
    progresso_maximo = 0

    # Executa os quadros da fase até ocorrer uma derrota, uma chegada ou a saída com ESC.
    while game:
        # aumenta a taxa de atualização para 60 FPS
        clock.tick(60)
        # Lê os eventos do teclado recebidos durante a partida.
        for event in pygame.event.get():
            # Verifica se o evento corresponde ao pressionamento de uma tecla.
            if event.type == pygame.KEYDOWN:
                # Interrompe a partida quando ESC é pressionado.
                if event.key == pygame.K_ESCAPE:
                    game = False
                # Registra o pedido de pulo ao pressionar ESPAÇO ou a seta para cima.
                elif event.key == pygame.K_SPACE or event.key == pygame.K_UP:
                    pedido_pulo = True

        # Sai do laço da fase antes de atualizar os objetos se o jogo foi encerrado.
        if not game:
            break

        # movimentação horizontal contínua
        # Isso permite mudar de direção sem precisar apertar várias vezes.
        teclas = pygame.key.get_pressed()
        # Move Pascal para a esquerda enquanto a seta esquerda estiver pressionada.
        if teclas[pygame.K_LEFT]:
            player.speedx = -5
        # Move Pascal para a direita enquanto a seta direita estiver pressionada.
        elif teclas[pygame.K_RIGHT]:
            player.speedx = 5
        # Zera a velocidade horizontal quando nenhuma das duas direções é escolhida.
        else:
            player.speedx = 0

        # Os matinhos descem enquanto o personagem está no ar
        personagem_movendo = not player.no_chao

        # Área visível do personagem dentro da imagem
        area_player = player.image.get_bounding_rect()

        # Posição dos pés antes do movimento
        pes_antes = player.rect.y + area_player.bottom

        # Guarda o topo visível de cada plataforma
        topos_antes = {}

        # Guarda a altura de apoio de cada plataforma antes de movimentá-la.
        for plataforma in plataformas:
            area = plataforma.image.get_bounding_rect()
            # Nas lanternas, apoia 20 pixels abaixo do topo visível para aproximar os pés.
            topos_antes[plataforma] = plataforma.rect.y + (area.top + 20 if luz_img is not None else area.centery)

        # Movimenta o personagem e as plataformas
        player.update()

        plataformas.update(personagem_movendo)

        # movimenta os sóis
        # Atualiza as posições dos sóis e dos itens conforme o movimento do cenário.
        sois.update(personagem_movendo)
        itens.update(personagem_movendo)
        # Reduz, a cada quadro, o tempo restante do efeito de superpulo.
        if tempo_superpulo > 0:
            tempo_superpulo -= 1
        # Verifica se o retângulo do personagem encostou no item especial.
        if pygame.sprite.spritecollide(player, itens, False):
            item = itens.sprite
            # Ativa o escudo quando esse for o tipo do item coletado.
            if item.tipo == "escudo":
                escudo = True
            # Ativa oito segundos de superpulo quando uma estrela é coletada.
            else:
                tempo_superpulo = 8 * 60
            # Reproduz o som de coleta e reposiciona o item com um novo sorteio.
            tocar_som("sol")
            item.novo_item()

        # O fundo desce enquanto o personagem está no ar
        if personagem_movendo:
            fundo_y += velocidade_fundo
            # Para ao mostrar o topo da imagem
            if fundo_y > 0:
                fundo_y = 0

        # Retângulo da parte visível do personagem na tela
        corpo = area_player.move(player.rect.x, player.rect.y)
        plataforma_pouso = None
        # Inicia a busca da plataforma que será atingida primeiro durante a queda.
        primeiro_instante = float("inf")

        # Compara o corpo visível de Pascal com as plataformas ativas.
        for plataforma in plataformas:
            # Ignora as plataformas que já desapareceram.
            if not plataforma.ativa:
                continue
            # Calcula a área visível de apoio e verifica a sobreposição na horizontal.
            area = plataforma.image.get_bounding_rect()
            apoio = area.move(plataforma.rect.x, plataforma.rect.y)
            # Calcula quanto da largura visível de Pascal está sobre esta plataforma.
            largura_sobreposta = max(0, min(corpo.right, apoio.right) - max(corpo.left, apoio.left))
            # Exige mais de 30% de apoio nas lanternas e mais de 50% nos matinhos.
            sobrepoe_x = largura_sobreposta > corpo.width * (0.3 if luz_img is not None else 0.5)
            # Compara a distância dos pés até o apoio antes e depois do movimento.
            distancia_antes = (topos_antes[plataforma] - pes_antes)
            distancia_depois = (apoio.top + 20 if luz_img is not None else apoio.centery) - corpo.bottom

            # Verifica se os pés alcançaram a plataforma por cima
            if (sobrepoe_x and distancia_antes >= 0 and distancia_depois <= 0 and player.speedy >= 0):
                movimento = distancia_antes - distancia_depois
                # Só calcula o instante de contato quando a distância até a plataforma diminuiu.
                if movimento > 0:
                    instante = distancia_antes / movimento
                    # Guarda o contato mais cedo para evitar escolher uma plataforma atravessada depois.
                    if instante < primeiro_instante:
                        primeiro_instante = instante
                        plataforma_pouso = plataforma

        # Se houve pouso, corrige a posição dos pés e atualiza o estado de apoio.
        if plataforma_pouso is not None:
            area = plataforma_pouso.image.get_bounding_rect()
            topo = plataforma_pouso.rect.y + (area.top + 20 if luz_img is not None else area.centery)
            # Alinha os pés 20 pixels abaixo do topo da lanterna ou ao apoio original do matinho
            player.rect.y = topo - area_player.bottom
            player.speedy = 0
            player.no_chao = True
            # Faz Pascal acompanhar o deslocamento horizontal da plataforma em que pousou.
            player.rect.x += plataforma_pouso.delta_x
            # Inicia a contagem de 30 quadros para uma plataforma frágil desaparecer após o pouso.
            if plataforma_pouso.tipo == "fragil" and plataforma_pouso.tempo_sumir is None:
                plataforma_pouso.tempo_sumir = 30  # some meio segundo após o pouso

        # Derrota quando o personagem toca o chão
        if player.rect.bottom >= HEIGHT:
            # Se houver escudo, consome a proteção e lança Pascal para cima em vez de encerrar a fase.
            if escudo:
                escudo = False
                player.rect.bottom = HEIGHT - 10
                player.speedy = -18
                player.no_chao = False
                pedido_pulo = False
                tocar_som("pulo")
            # Sem escudo, registra a derrota, reproduz seu som e encerra o laço da fase.
            else:
                resultado = "game_over"
                tocar_som("game_over")
                game = False
                break

        # Posição do objetivo na tela: porta na fase 1, lanterna na fase 2.
        objetivo_tela = objetivo.move(0, int(fundo_y))

        # Atualiza o corpo após a correção da posição no pouso
        corpo = area_player.move(player.rect.x, player.rect.y)

        # Usa os mesmos pixels, tamanho e direção que serão desenhados para Pascal.
        imagem_pascal, retangulo_pascal = player.desenhar(None)
        mascara_pascal = pygame.mask.from_surface(imagem_pascal)

        # Na porta, só considera contato com a área configurada da abertura.
        if luz_img is None:
            retangulo_objetivo = objetivo_tela
            mascara_objetivo = pygame.mask.Mask(objetivo_tela.size, fill=True)
        # Na lanterna, usa sua forma visível e o tamanho atual da pulsação.
        else:
            imagem_luz, retangulo_objetivo = desenhar_luz(None, objetivo_tela)
            mascara_objetivo = pygame.mask.from_surface(imagem_luz, 100)

        # A chegada só acontece quando os pixels de Pascal tocam o objetivo.
        deslocamento = (retangulo_objetivo.x - retangulo_pascal.x,
                        retangulo_objetivo.y - retangulo_pascal.y)
        if mascara_pascal.overlap(mascara_objetivo, deslocamento) is not None:
            tocar_som("vitoria")
            entrou = animar_entrada(player, objetivo_tela, fundo_y, plataformas, sois, itens, pontos)
            # Se ESC interrompeu a animação, encerra sem exibir uma tela de resultado.
            if not entrou:
                resultado = None
            # Se ainda existe outra fase, registra a conclusão desta fase para permitir avançar.
            elif fase_atual < len(FASES) - 1:
                resultado = "fase_concluida"
            # Na última fase, registra a vitória completa do jogo.
            else:
                resultado = "vitoria"
            # Encerra o laço da fase para mostrar o resultado ou finalizar a execução.
            game = False
            break

        # Executa o pedido de pulo somente quando Pascal estiver apoiado.
        if player.no_chao and pedido_pulo:
           #executa o pulo assim q o jogador tocar no mato
            # Escolhe a velocidade de pulo normal ou a velocidade maior do superpulo.
            player.speedy = -19 if tempo_superpulo > 0 else -15
            tocar_som("pulo")
            player.no_chao = False 
            # reseta o pedido 
            pedido_pulo = False 

        # Reaproveita os matinhos que saíram por baixo
        # Agrupa as plataformas que estão na mesma altura
        linhas = {}

        # Agrupa as plataformas pela altura para reaproveitar cada dupla da mesma fileira.
        for plataforma in plataformas:
            y = plataforma.rect.y
            linhas.setdefault(y, []).append(plataforma)

        # Reposiciona cada dupla que saiu por baixo
        for y, linha in linhas.items():
            # Reposiciona apenas as fileiras que já passaram pelo limite inferior da janela.
            if y > HEIGHT:
                # Calcula a nova altura acima da plataforma mais alta, respeitando o espaçamento da fase.
                novo_y = min(plataforma.rect.y for plataforma in plataformas) - intervalo_plataformas(fundo_y)
                # Sorteia novas posições por coluna e reconfigura o tipo de cada plataforma reaproveitada.
                for coluna, plataforma in enumerate(linha):
                    inicio = coluna * (WIDTH // 2)
                    fim = (coluna + 1) * (WIDTH // 2)
                    plataforma.rect.x = random.randint(inicio, fim - plataforma.rect.width)
                    plataforma.rect.y = novo_y
                    plataforma.configurar(coluna, proxima_linha)
                # Avança o contador de fileiras depois de reposicionar a dupla.
                proxima_linha += 1

        # verifica se o jogador coletou o sol
        if pygame.sprite.spritecollide(player, sois, False):
            pontos += 10
            tocar_som("sol")
            # O sol aparece em outro lugar depois de coletado
            sol.novo_sol()
        # Desenha o fundo
        window.blit(background, (0, int(fundo_y)))
        # Desenha os matinhos primeiro
        plataformas.draw(window)

        # desenha os sóis
        sois.draw(window)
        # Desenha os itens especiais e a lanterna da segunda fase antes do personagem.
        itens.draw(window)
        if luz_img is not None:
            window.blit(imagem_luz, retangulo_objetivo)

        # Desenha o personagem por último
        player.desenhar(window)
        # Mostra um círculo azul ao redor de Pascal enquanto o escudo estiver ativo.
        if escudo:
            pygame.draw.circle(window, (90, 210, 255), player.rect.center, 53, 3)
        # Monta a lista de mensagens dos efeitos que estão ativos no momento.
        efeitos = []
        # Inclui a indicação de escudo ativo na lista de mensagens.
        if escudo:
            efeitos.append("Escudo ativo")
        # Converte os quadros restantes do superpulo em segundos para mostrar na tela.
        if tempo_superpulo > 0:
            efeitos.append(f"Superpulo: {math.ceil(tempo_superpulo / 60)}s")
        # Se houver efeitos ativos, junta suas mensagens e as desenha abaixo do recorde.
        if efeitos:
            texto_efeitos = font_mensagem.render(" | ".join(efeitos), True, (255, 230, 110))
            window.blit(texto_efeitos, (15, 90))

        # mostra a pontuação na tela
        distancia_objetivo = max(0, player.rect.centery - (objetivo.centery + fundo_y))
        progresso = max(0, min(0.99, 1 - distancia_objetivo / distancia_inicial_objetivo))
        progresso_maximo = max(progresso_maximo, progresso)
        # Cria o retângulo de fundo da barra de progresso e calcula sua parte preenchida.
        barra = pygame.Rect(WIDTH - 170, 20, 150, 16)
        pygame.draw.rect(window, (35, 25, 50), barra, border_radius=8)
        preenchimento = barra.copy()
        preenchimento.width = round(barra.width * progresso_maximo)
        # Desenha o preenchimento da barra somente quando sua largura for maior que zero.
        if preenchimento.width > 0:
            pygame.draw.rect(window, (190, 135, 245), preenchimento, border_radius=8)
        # Escolhe Torre ou Céu para identificar o percurso e prepara o texto de porcentagem.
        nome_progresso = "Torre" if luz_img is None else "Céu"
        texto_progresso = font_mensagem.render(f"{nome_progresso}: {int(progresso_maximo * 100)}%", True, (255, 255, 255))
        window.blit(texto_progresso, texto_progresso.get_rect(topright=(WIDTH - 15, 44)))
        # Prepara e desenha a pontuação atual e o maior valor entre o recorde e os pontos da partida.
        texto_pontos = font_pontos.render(f'Pontos: {pontos}',True,(128, 0, 128))
        window.blit(texto_pontos, (15, 15))
        texto_recorde = font_mensagem.render(f"Recorde: {max(recorde, pontos)}", True, (255, 255, 255))
        window.blit(texto_recorde, (15, 55))
        # Mostra o número da fase atual, somando um ao índice que começa em zero.
        texto_fase = font_mensagem.render(f"Fase {fase_atual + 1}/{len(FASES)}", True, (255, 255, 255))
        window.blit(texto_fase, (15, HEIGHT - 35))
        # Exibe o objetivo específico da segunda fase enquanto a lanterna estiver sendo usada.
        if luz_img is not None:
            aviso_objetivo = font_ajuda.render("Alcance a lanterna dourada!", True, (255, 230, 140))
            window.blit(aviso_objetivo, aviso_objetivo.get_rect(center=(WIDTH // 2, HEIGHT - 55)))
        # Mostra o quadro completo da partida depois de desenhar todos os elementos.
        pygame.display.update()

    return resultado, pontos, fundo_y


# TELA DE RESULTADO

def mostrar_tela_final(resultado, pontos, fundo_y, erro_recorde, fase_atual):
    """Mostra o resultado e devolve sair, avancar ou reiniciar."""
    while True:
        # Limita a atualização da tela de resultado a 60 quadros por segundo.
        clock.tick(60)
        # Devolve a escolha para main(), que decide a próxima fase ou o reinício.
        for event in pygame.event.get():
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    return "sair"
                elif event.key == pygame.K_RETURN:
                    if resultado == "fase_concluida":
                        return "avancar"
                    return "reiniciar"

        # Desenha o cenário atrás da mensagem
        window.blit(background, (0, int(fundo_y)))

        # Escurece o fundo para facilitar a leitura
        sombra = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        sombra.fill((0, 0, 0, 170))
        window.blit(sombra, (0, 0))

        # Prepara o título, a mensagem e a cor da conclusão de uma fase intermediária.
        if resultado == "fase_concluida":
            titulo = f"FASE {fase_atual + 1} CONCLUÍDA!"
            mensagem = "Agora alcance a lanterna dourada!"
            cor = (255, 220, 100)
        # Prepara a mensagem de vitória após Pascal alcançar a lanterna dourada.
        elif resultado == "vitoria":
            titulo = "VITÓRIA!"
            mensagem = "Pascal alcançou a luz!"
            cor = (255, 220, 100)
        # Prepara o título e a mensagem de derrota quando Pascal cair sem proteção.
        else:
            titulo = "GAME OVER"
            mensagem = "Pascal caiu no chão!"
            cor = (255, 130, 130)

        # Escolhe uma fonte menor para o título mais comprido de conclusão de fase.
        fonte_titulo = font_pontos if resultado == "fase_concluida" else font_final
        texto_titulo = fonte_titulo.render(titulo, True, cor)
        texto_mensagem = font_mensagem.render(mensagem, True, (255, 255, 255))
        texto_final = font_pontos.render(f"Pontuação final: {pontos}", True, (255, 255, 255))
        # Mostra o comando para avançar quando ainda houver outra fase.
        if resultado == "fase_concluida":
            comando = "ENTER para a próxima fase"
        # Após derrota ou vitória final, mostra o comando para jogar novamente desde a fase 1.
        else:
            comando = "ENTER para jogar novamente"
        # Transforma os comandos de reinício e saída em imagens de texto.
        texto_reiniciar = font_mensagem.render(comando, True, (255, 255, 255))
        texto_sair = font_mensagem.render("Pressione ESC para sair", True, (255, 255, 255))

        # Desenha o título, a mensagem e a pontuação final nas posições definidas.
        window.blit(texto_titulo, texto_titulo.get_rect(center=(WIDTH // 2, 250)))
        window.blit(texto_mensagem, texto_mensagem.get_rect(center=(WIDTH // 2, 325)))
        window.blit(texto_final,texto_final.get_rect(center=(WIDTH // 2, 400)))
        # Acrescenta um aviso ao recorde quando sua gravação falhou.
        aviso_recorde = " (não salvo)" if erro_recorde else ""
        texto_recorde = font_mensagem.render(f"Recorde: {recorde}{aviso_recorde}", True, (255, 220, 100))
        # Desenha o recorde e os comandos de continuação e saída.
        window.blit(texto_recorde, texto_recorde.get_rect(center=(WIDTH // 2, 440)))
        window.blit(texto_reiniciar, texto_reiniciar.get_rect(center=(WIDTH // 2, 490)))
        window.blit(texto_sair,texto_sair.get_rect(center=(WIDTH // 2, 520)))

        pygame.display.update()


# CONTROLE DAS TELAS E FASES

def main():
    """Organiza a tela inicial, as duas fases, o recorde e o reinício."""
    global recorde
    fase_atual = 0
    pontos_acumulados = 0
    erro_recorde = False

    try:
        if not mostrar_tela_inicial():
            return

        while True:
            resultado, pontos, fundo_y = jogar_fase(fase_atual, pontos_acumulados)
            # Atualiza o recorde da execução atual, inclusive ao sair com ESC.
            if pontos > recorde:
                recorde = pontos
                erro_recorde = not salvar_recorde(recorde)

            # ESC durante a partida ou a animação encerra sem mostrar o resultado.
            if resultado is None:
                return

            acao = mostrar_tela_final(resultado, pontos, fundo_y, erro_recorde, fase_atual)
            if acao == "sair":
                return
            elif acao == "avancar":
                fase_atual += 1
                pontos_acumulados = pontos
            else:
                fase_atual = 0
                pontos_acumulados = 0
    finally:
        # Libera os recursos mesmo se ocorrer um erro durante a execução.
        pygame.quit()


if __name__ == "__main__":
    main()
