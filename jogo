    largura, altura = fundo.get_size()
    altura_fundo = round(altura * WIDTH / largura)
    fundo = pygame.transform.smoothscale(fundo, (WIDTH, altura_fundo))

    plataforma = carregar_imagem(imagens['plataforma'], True)
    plataforma = pygame.transform.scale(plataforma, (MATINHO_WIDTH, MATINHO_HEIGHT))
    personagem = carregar_imagem(imagens['personagem'], True)
