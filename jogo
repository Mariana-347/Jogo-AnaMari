# A distância cresce de 105 até 140 pixels, conforme a subida.
def intervalo_plataformas(fundo_atual):
    percurso = max(1, ALTURA_FUNDO - HEIGHT)
    progresso = max(0, min(1, (fundo_atual - (HEIGHT - ALTURA_FUNDO)) / percurso))
    return round(105 + 35 * progresso)

class Ship(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH / 2
        self.rect.bottom = HEIGHT - 10
        self.speedx = 0
        self.speedy = -15
        self.no_chao = True
        self.bottom_anterior = self.rect.bottom
        self.olhando_esquerda = False
        self.quadro_animacao = 0

    def desenhar(self, tela):
        imagem = pygame.transform.flip(self.image, self.olhando_esquerda, False)
        if not self.no_chao:
            tamanho = (PASCAL_WIDTH - 6, PASCAL_HEIGHT + 6)
        elif self.speedx:
            oscilacao = 3 if (self.quadro_animacao // 6) % 2 else -3
            tamanho = (PASCAL_WIDTH + oscilacao, PASCAL_HEIGHT - oscilacao)
        else:
            tamanho = (PASCAL_WIDTH, PASCAL_HEIGHT)
        imagem = pygame.transform.smoothscale(imagem, tamanho)
        tela.blit(imagem, imagem.get_rect(midbottom=self.rect.midbottom))

    def update(self):
        self.quadro_animacao += 1
        if self.speedx:
            self.olhando_esquerda = self.speedx < 0
        # Guarda a posição dos pés antes do movimento
        self.bottom_anterior = self.rect.bottom
        self.rect.x += self.speedx
        # pulo suave
        self.speedy += 0.55
        #  movimento vertical contínuo
        self.rect.y += self.speedy
        # Limites laterais
        if self.rect.right > WIDTH:
            self.rect.right = WIDTH
        if self.rect.left < 0:
            self.rect.left = 0
        # A colisão verificará se continua apoiado
        self.no_chao = False

# cria novas plataformas (matinhos)
class matinho(pygame.sprite.Sprite):
    def __init__(self, img, y):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, WIDTH - self.rect.width)
        self.rect.y = y
        self.top_anterior = self.rect.top
        self.imagem_original = img
        self.tipo = "normal"
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = 1
        self.delta_x = 0
        self.limite_esquerdo = 0
        self.limite_direito = WIDTH - self.rect.width

    def configurar(self, coluna, numero_linha):
        # Uma plataforma móvel a cada quatro fileiras.
        # Os lados se alternam: esquerda, direita, esquerda, direita...
        linha_movel = numero_linha % 4 == 3
        lado_movel = (numero_linha // 4) % 2
        if linha_movel:
            self.tipo = "movel" if coluna == lado_movel else "normal"
        elif numero_linha > 0 and coluna == 1:
            self.tipo = random.choice(["normal", "fragil"])
        else:
            self.tipo = "normal"
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = random.choice([-1, 1])
        self.delta_x = 0
        self.limite_esquerdo = coluna * (WIDTH // 2)
        self.limite_direito = (coluna + 1) * (WIDTH // 2) - self.rect.width
        self.image = self.imagem_original.copy()
        if self.tipo == "movel":
            self.image.fill((150, 200, 255, 255), special_flags=pygame.BLEND_RGBA_MULT)
        elif self.tipo == "fragil":
            self.image.fill((255, 180, 140, 255), special_flags=pygame.BLEND_RGBA_MULT)

    def update(self, personagem_movendo):
        self.top_anterior = self.rect.top
        x_anterior = self.rect.x
        if self.tipo == "movel" and self.ativa:
            self.rect.x += self.direcao * 2
            if self.rect.x <= self.limite_esquerdo or self.rect.x >= self.limite_direito:
                self.rect.x = max(self.limite_esquerdo, min(self.limite_direito, self.rect.x))
                self.direcao *= -1
        self.delta_x = self.rect.x - x_anterior
        if self.tempo_sumir is not None:
            self.tempo_sumir -= 1
            if self.tempo_sumir <= 0:
                self.ativa = False
                self.image = pygame.Surface(self.imagem_original.get_size(), pygame.SRCALPHA)
        # Só desce enquanto o personagem está no ar
        if personagem_movendo:
            self.rect.y += 3

# classe do solzinho
# O jogador ganha pontos quando encosta no sol.
class Sol(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.novo_sol()

    def novo_sol(self):
        # Posiciona o sol em um local aleatório da tela
        self.rect.x = random.randint(150, WIDTH - self.rect.width)
        self.rect.y = random.randint(100, HEIGHT - 200)

    def update(self, personagem_movendo):
        # O sol acompanha o movimento da tela
        if personagem_movendo:
            self.rect.y += 3
        # Se sair da tela, aparece em outro lugar
        if self.rect.top > HEIGHT:
            self.novo_sol()

