# Efeitos simples; o jogo também funciona se o computador não tiver áudio.
def criar_som(frequencia, duracao):
    # Se o áudio não foi inicializado, devolve None para o jogo continuar sem esse som.
    if pygame.mixer.get_init() is None:
        return None
    # Obtém a taxa de áudio e calcula quantas amostras serão necessárias para a duração escolhida.
    taxa = pygame.mixer.get_init()[0]
    total = int(taxa * duracao)
    # Gera uma onda senoidal com volume decrescente e a guarda como números inteiros de 16 bits.
    amostras = array("h", (int(7000 * math.sin(2 * math.pi * frequencia * i / taxa) * (1 - i / total)) for i in range(total)))
    # Transforma as amostras em um efeito sonoro que o Pygame consegue reproduzir.
    return pygame.mixer.Sound(buffer=amostras)

