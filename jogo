# A distância cresce de 105 até 140 pixels, conforme a subida.
def intervalo_plataformas(fundo_atual):
    percurso = max(1, ALTURA_FUNDO - HEIGHT)
    progresso = max(0, min(1, (fundo_atual - (HEIGHT - ALTURA_FUNDO)) / percurso))
    return round(105 + 35 * progresso)

def desenhar_luz(tela, posicao):
    """Desenha a lanterna com uma pequena pulsação; a porta não usa imagem extra."""
    if luz_img is None:
        return
    pulso = 1 + 0.04 * math.sin(pygame.time.get_ticks() / 250)
    tamanho = (round(luz_img.get_width() * pulso), round(luz_img.get_height() * pulso))
    imagem = pygame.transform.smoothscale(luz_img, tamanho)
    tela.blit(imagem, imagem.get_rect(center=posicao.center))


# Animação de chegada: aproxima Pascal da porta ou da lanterna e o faz desaparecer.
def animar_entrada(personagem, objetivo_destino, fundo_atual, plataformas, sois, itens, pontos):
    duracao = 1200  # milissegundos
    decorrido = 0
    personagem.speedx = 0
    personagem.speedy = 0

    imagem = pygame.transform.flip(personagem.image, personagem.olhando_esquerda, False)
    area_visivel = imagem.get_bounding_rect()
    if area_visivel.width == 0 or area_visivel.height == 0:
        area_visivel = imagem.get_rect()
    imagem = imagem.subsurface(area_visivel).copy()
    inicio = area_visivel.move(personagem.rect.topleft).center
    destino = objetivo_destino.center
    escala_final = max(0.05, min(1, objetivo_destino.width * 0.75 / imagem.get_width(),
                                      objetivo_destino.height * 0.85 / imagem.get_height()))

    # Guarda o cenário sem o personagem. Tudo fica parado durante a entrada.
    cena = pygame.Surface((WIDTH, HEIGHT))
    cena.blit(background, (0, int(fundo_atual)))
    plataformas.draw(cena)
    sois.draw(cena)
    itens.draw(cena)
    desenhar_luz(cena, objetivo_destino)
    texto_pontos = font_pontos.render(f"Pontos: {pontos}", True, (128, 0, 128))
    texto_recorde = font_mensagem.render(f"Recorde: {max(recorde, pontos)}", True, (255, 255, 255))
    nome_progresso = "Torre" if luz_img is None else "Céu"
    texto_progresso = font_mensagem.render(f"{nome_progresso}: 100%", True, (255, 255, 255))
    cena.blit(texto_pontos, (15, 15))
    cena.blit(texto_recorde, (15, 55))
    pygame.draw.rect(cena, (190, 135, 245), (WIDTH - 170, 20, 150, 16), border_radius=8)
    cena.blit(texto_progresso, texto_progresso.get_rect(topright=(WIDTH - 15, 44)))

    while True:
        # Continua lendo os eventos, sem usar esperas que travem a janela.
        for event in pygame.event.get():
            if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                return False

        progresso_animacao = min(1, decorrido / duracao)
        suave = progresso_animacao * progresso_animacao * (3 - 2 * progresso_animacao)
        escala = 1 + (escala_final - 1) * suave
        tamanho = (max(1, round(imagem.get_width() * escala)),
                   max(1, round(imagem.get_height() * escala)))
        quadro = pygame.transform.smoothscale(imagem, tamanho)
        # Desaparece aos poucos na segunda metade da entrada.
        opacidade = round(255 * (1 - max(0, (progresso_animacao - 0.55) / 0.45)))
        quadro.set_alpha(max(0, min(255, opacidade)))
        centro = (round(inicio[0] + (destino[0] - inicio[0]) * suave),
                  round(inicio[1] + (destino[1] - inicio[1]) * suave))
        posicao = quadro.get_rect(center=centro)

        window.blit(cena, (0, 0))
        if luz_img is not None:
            desenhar_luz(window, objetivo_destino)
        window.blit(quadro, posicao)
        if luz_img is not None:
            # Um clarão dourado acompanha o desaparecimento de Pascal na luz.
            clarao = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            clarao.fill((255, 225, 130, round(100 * suave)))
            window.blit(clarao, (0, 0))
        pygame.display.update()
        if progresso_animacao >= 1:
            return True
        decorrido += clock.tick(60)

class Ship(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH / 2
        self.rect.bottom = HEIGHT - 10
        self.speedx = 0
        self.speedy = -15
        self.no_chao = True
        self.bottom_anterior = self.rect.bottom
        self.olhando_esquerda = False
        self.quadro_animacao = 0

    def desenhar(self, tela):
        imagem = pygame.transform.flip(self.image, self.olhando_esquerda, False)
        if not self.no_chao:
            tamanho = (PASCAL_WIDTH - 6, PASCAL_HEIGHT + 6)
        elif self.speedx:
            oscilacao = 3 if (self.quadro_animacao // 6) % 2 else -3
            tamanho = (PASCAL_WIDTH + oscilacao, PASCAL_HEIGHT - oscilacao)
        else:
            tamanho = (PASCAL_WIDTH, PASCAL_HEIGHT)
        imagem = pygame.transform.smoothscale(imagem, tamanho)
        tela.blit(imagem, imagem.get_rect(midbottom=self.rect.midbottom))

    def update(self):
        self.quadro_animacao += 1
        if self.speedx:
            self.olhando_esquerda = self.speedx < 0
        # Guarda a posição dos pés antes do movimento
        self.bottom_anterior = self.rect.bottom
        self.rect.x += self.speedx
        # pulo suave
        self.speedy += 0.55
        #  movimento vertical contínuo
        self.rect.y += self.speedy
        # proteção para o personagem nao sair pelo teto
        if self.rect.top < 0:
            self.rect.top = 0
            self.speedy = 0
        # Limites laterais
        if self.rect.right > WIDTH:
            self.rect.right = WIDTH
        if self.rect.left < 0:
            self.rect.left = 0
        # A colisão verificará se continua apoiado
        self.no_chao = False

# cria novas plataformas (matinhos)
class matinho(pygame.sprite.Sprite):
    def __init__(self, img, y):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, WIDTH - self.rect.width)
        self.rect.y = y
        self.top_anterior = self.rect.top
        self.imagem_original = img
        self.tipo = "normal"
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = 1
        self.delta_x = 0
        self.limite_esquerdo = 0
        self.limite_direito = WIDTH - self.rect.width

    def configurar(self, coluna, numero_linha):
        # Uma plataforma móvel a cada quatro fileiras.
        # Os lados se alternam: esquerda, direita, esquerda, direita...
        linha_movel = numero_linha % 4 == 3
        lado_movel = (numero_linha // 4) % 2
        if linha_movel:
            self.tipo = "movel" if coluna == lado_movel else "normal"
        elif numero_linha > 0 and coluna == 1:
            self.tipo = random.choice(["normal", "fragil"])
        else:
            self.tipo = "normal"
        self.ativa = True
        self.tempo_sumir = None
        self.direcao = random.choice([-1, 1])
        self.delta_x = 0
        self.limite_esquerdo = coluna * (WIDTH // 2)
        self.limite_direito = (coluna + 1) * (WIDTH // 2) - self.rect.width
        self.image = self.imagem_original.copy()
        if self.tipo == "movel":
            self.image.fill((150, 200, 255, 255), special_flags=pygame.BLEND_RGBA_MULT)
        elif self.tipo == "fragil":
            self.image.fill((255, 180, 140, 255), special_flags=pygame.BLEND_RGBA_MULT)

    def update(self, personagem_movendo):
        self.top_anterior = self.rect.top
        x_anterior = self.rect.x
        if self.tipo == "movel" and self.ativa:
            self.rect.x += self.direcao * 2
            if self.rect.x <= self.limite_esquerdo or self.rect.x >= self.limite_direito:
                self.rect.x = max(self.limite_esquerdo, min(self.limite_direito, self.rect.x))
                self.direcao *= -1
        self.delta_x = self.rect.x - x_anterior
        if self.tempo_sumir is not None:
            self.tempo_sumir -= 1
            if self.tempo_sumir <= 0:
                self.ativa = False
                self.image = pygame.Surface(self.imagem_original.get_size(), pygame.SRCALPHA)
        # Só desce enquanto o personagem está no ar
        if personagem_movendo:
            self.rect.y += 3

# classe do solzinho
# O jogador ganha pontos quando encosta no sol.
class Sol(pygame.sprite.Sprite):
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.novo_sol()

    def novo_sol(self):
        # Posiciona o sol em um local aleatório da tela
        self.rect.x = random.randint(150, WIDTH - self.rect.width)
        self.rect.y = random.randint(100, HEIGHT - 200)

    def update(self, personagem_movendo):
        # O sol acompanha o movimento da tela
        if personagem_movendo:
            self.rect.y += 3
        # Se sair da tela, aparece em outro lugar
        if self.rect.top > HEIGHT:
            self.novo_sol()

class ItemEspecial(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((36, 36), pygame.SRCALPHA)
        self.rect = self.image.get_rect()
        self.novo_item()

    def novo_item(self):
        self.tipo = random.choice(["escudo", "pulo"])
        self.image.fill((0, 0, 0, 0))
        if self.tipo == "escudo":
            pygame.draw.polygon(self.image, (90, 210, 255), [(18, 1), (33, 7), (30, 24), (18, 35), (6, 24), (3, 7)])
        else:
            pontas = []
            for i in range(10):
                angulo = -math.pi / 2 + i * math.pi / 5
                raio = 17 if i % 2 == 0 else 8
                pontas.append((18 + math.cos(angulo) * raio, 18 + math.sin(angulo) * raio))
            pygame.draw.polygon(self.image, (255, 220, 80), pontas)
        self.rect.x = random.randint(30, WIDTH - 66)
        self.rect.y = -random.randint(250, 500)

    def update(self, personagem_movendo):
        if personagem_movendo:
            self.rect.y += 3
        if self.rect.top > HEIGHT:
            self.novo_item()

