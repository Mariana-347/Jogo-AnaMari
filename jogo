import pygame
pygame.init ()

window = pygame.display.set_mode((1000,600))

pygame.display.set_caption('Jogo da MariAna')

game = True

while game:
    for event in pygame.event.get():
        if event.type == pygame.KEYUP:
            pygame.quit()
            game = False

    window.fill((200,162,200))
    pygame.display.update()
pygame.quit()
