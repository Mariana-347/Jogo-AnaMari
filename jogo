# Carrega uma imagem usando o caminho da pasta em que este código foi salvo.
def carregar_imagem(nome, transparente=False):
    """Abre uma imagem da pasta do jogo."""
    # Junta o nome recebido à pasta do jogo para obter o caminho completo da imagem.
    caminho = PASTA_JOGO / nome
    # Aceita também o nome com (1) usado no arquivo de fundo enviado.
    if not caminho.exists() and nome == 'Torre dourada entre florestas e cachoeiras.png':
        caminho = PASTA_JOGO / 'Torre dourada entre florestas e cachoeiras(1).png'
    # Lê o arquivo da imagem antes de convertê-lo para o formato usado pela janela.
    imagem = pygame.image.load(str(caminho))
    # Preserva o canal de transparência quando ele for necessário para o desenho.
    if transparente:
        return imagem.convert_alpha()
    # Para imagens opacas, usa a conversão comum, adequada ao fundo do cenário.
    return imagem.convert()

