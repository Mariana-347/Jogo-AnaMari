# O jogador ganha pontos quando encosta no sol.
class Sol(pygame.sprite.Sprite):
    # Cria um sol coletável e sorteia sua primeira posição.
    def __init__(self, img):
        pygame.sprite.Sprite.__init__(self)
        self.image = img
        self.rect = self.image.get_rect()
        self.novo_sol()

    # Reposiciona o sol dentro dos intervalos definidos para a tela.
    def novo_sol(self):
        # Posiciona o sol em um local aleatório da tela
        self.rect.x = random.randint(150, WIDTH - self.rect.width)
        self.rect.y = random.randint(100, HEIGHT - 200)

    # Faz o sol acompanhar a descida do cenário e reaparecer quando sai da janela.
    def update(self, personagem_movendo):
        # O sol acompanha o movimento da tela
        if personagem_movendo:
            self.rect.y += 3
        # Se sair da tela, aparece em outro lugar
        if self.rect.top > HEIGHT:
            self.novo_sol()

# Define os itens que concedem escudo ou superpulo ao personagem.
class ItemEspecial(pygame.sprite.Sprite):
    # Cria uma superfície transparente para desenhar o item e sorteia o primeiro tipo.
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((36, 36), pygame.SRCALPHA)
        self.rect = self.image.get_rect()
        self.novo_item()

    # Sorteia o tipo de item, desenha seu símbolo e escolhe onde ele aparecerá.
    def novo_item(self):
        # Escolhe entre escudo e superpulo e limpa o desenho do item anterior.
        self.tipo = random.choice(["escudo", "pulo"])
        self.image.fill((0, 0, 0, 0))
        # Desenha um polígono azul para representar o escudo.
        if self.tipo == "escudo":
            pygame.draw.polygon(self.image, (90, 210, 255), [(18, 1), (33, 7), (30, 24), (18, 35), (6, 24), (3, 7)])
        # Para o superpulo, monta uma estrela amarela alternando pontas longas e curtas.
        else:
            pontas = []
            # Calcula os dez vértices da estrela usando os ângulos de uma volta completa.
            for i in range(10):
                angulo = -math.pi / 2 + i * math.pi / 5
                raio = 17 if i % 2 == 0 else 8
                pontas.append((18 + math.cos(angulo) * raio, 18 + math.sin(angulo) * raio))
            # Une os vértices calculados para preencher o desenho da estrela.
            pygame.draw.polygon(self.image, (255, 220, 80), pontas)
        # Sorteia a posição horizontal e coloca o item acima da parte visível da janela.
        self.rect.x = random.randint(30, WIDTH - 66)
        self.rect.y = -random.randint(250, 500)

    # Atualiza a descida do item e verifica se ele precisa ser reposicionado.
    def update(self, personagem_movendo):
        # Faz o item descer somente quando o cenário também estiver descendo.
        if personagem_movendo:
            self.rect.y += 3
        # Sorteia outro item quando o atual passa pelo limite inferior da janela.
        if self.rect.top > HEIGHT:
            self.novo_item()

