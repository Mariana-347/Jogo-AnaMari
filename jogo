    sol = carregar_imagem(imagens['sol'], True)
    sol = pygame.transform.scale(sol, (SOL_WIDTH, SOL_HEIGHT))

    x, y, largura_porta, altura_porta = imagens['porta']
    objetivo_fase = pygame.Rect(round(WIDTH * x), round(altura_fundo * y),
                            round(WIDTH * largura_porta), round(altura_fundo * altura_porta))
    # Na segunda fase, o objetivo passa a ser uma imagem visível no céu.
    luz = None
